rules_version = '2';

// bach-cv (v2). The data model is documented in docs/data-design.html.
// The old site's collections (config, user, message) are no longer readable or writable from a browser: they fall
// through to the final "deny everything else" rule. Their data is not deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    // site/shell, live, profile, settings: public read, never written from the browser
    match /site/{doc} {
      allow read: if doc in ['shell', 'live', 'profile', 'settings'];
      allow write: if false;
    }

    // Content collections. `visible` is enforced here, so a switched-off item is never sent to a visitor.
    // The browser must ask with where('visible', '==', true); a query that could return a hidden document is
    // rejected as a whole. The seed script and the build use the Admin SDK and see everything.
    match /{collection}/{id} {
      allow get, list: if collection in [
          'skills', 'experience', 'education', 'projects',
          'certificates', 'services', 'payments', 'contacts'
        ]
        && resource.data.visible == true;
      allow write: if false;
    }

    // Contact form: create only, validated, server timestamp, no reading back
    match /messages/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'topic', 'message', 'locale', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 1000
        && (!('topic' in request.resource.data)
            || (request.resource.data.topic is string && request.resource.data.topic.size() <= 40))
        && (!('locale' in request.resource.data) || request.resource.data.locale in ['en', 'vi'])
        && request.resource.data.createdAt == request.time;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
