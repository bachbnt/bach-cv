# Firebase web config (public values; security comes from the Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase App Check (optional): the key ID of a score-based reCAPTCHA Enterprise key (Google Cloud Fraud Defense). Without it App Check stays off. See the README.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# Chat proxy: the Cloudflare Worker URL (see worker/README.md). Provider API keys live in the Worker, never here.
NEXT_PUBLIC_CHAT_PROXY_URL=""

# Cloudflare Turnstile (optional): the SITE key of an Invisible widget, public. With it the contact form sends a token with the email
# notification; the Worker checks it when it has TURNSTILE_SECRET. Without it nothing changes (see worker/README.md).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Cloudflare Worker local secrets (copy to worker/.dev.vars when running the worker with Wrangler)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_PER_MINUTE="10"
RATE_LIMIT_PER_DAY="200"
# The Firebase project whose public content the Worker reads to build the chat system prompt (wrangler.toml var)
FIREBASE_PROJECT_ID=""
# Optional: when set, /notify needs a valid Turnstile token (the secret key of the widget; a Worker secret, never NEXT_PUBLIC_)
TURNSTILE_SECRET=""

# Firebase service account for scripts that use the Admin SDK (never commit the file)
GOOGLE_APPLICATION_CREDENTIALS="firebase-service-account.json"
