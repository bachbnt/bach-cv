{
  "name": "bach-cv",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,css,md}\" \"*.{ts,mjs}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "prepare": "husky",
    "test:automation": "playwright test",
    "test:automation:headed": "playwright test --headed",
    "test:automation:ui": "playwright test --ui",
    "test:automation:install": "playwright install chromium",
    "backup:firestore": "node scripts/firestore-backup.mjs",
    "restore:firestore": "node scripts/firestore-restore.mjs"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src,tests}/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/query-sync-storage-persister": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.2.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^14.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
